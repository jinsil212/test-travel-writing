    "aAppend": 1,
    "segs": [ {
      "utf8": "\n"
    } ]
  }, {
    "tStartMs": 603560,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "因為貞子丹他不僅學習中國,他是拍的是最典型的一個",
      "acAsrConf": 0
    } ]
