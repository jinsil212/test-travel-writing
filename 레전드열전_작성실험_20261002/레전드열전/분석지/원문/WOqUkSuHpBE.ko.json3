    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "我今天的就告訴大家真子丹為什麼?因為貞子丹他不僅學習中國,他是拍的是最典型的一個MMA的電影。",
      "acAsrConf": 0
    } ]
